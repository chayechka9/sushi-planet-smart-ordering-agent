# Copy this file to .env for local development.
# Never commit real credentials or payment data.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Disabled unless explicitly set to true. A key alone does not enable runtime.
OPENAI_RUNTIME_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=high

# Disabled unless explicitly set to true. A token alone does not start polling.
TELEGRAM_RUNTIME_ENABLED=false
TELEGRAM_BOT_TOKEN=

# Delivery tariffs are loaded from ignored .telegram-delivery-tariffs.json.
# See config/telegram-delivery-tariffs.example.json and its JSON schema.

# Add test Poster, the selected payment provider and channel credentials only
# after their access is confirmed. Never put production credentials here.
POSTER_ACCOUNT=
POSTER_TOKEN=
POSTER_MENU_SPOT_ID=

# SumUp sandbox only. The API key must belong to the sandbox merchant above.
SUMUP_SANDBOX_MERCHANT_CODE=
SUMUP_SANDBOX_API_KEY=
