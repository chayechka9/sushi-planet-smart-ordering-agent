{
  "name": "sushi-planet-smart-ordering-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Server foundation for the Sushi Planet Smart Ordering Agent",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "poster:check-menu": "tsx src/scripts/check-poster-menu.ts",
    "sumup:check-access": "tsx src/scripts/check-sumup-access.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
